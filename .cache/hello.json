{"_ts":1795072506826,"data":{"word":"hello","ukphone":"həˈləʊ","usphone":"həˈloʊ","ukSpeech":"https://dict.youdao.com/dictvoice?audio=hello&type=1","usSpeech":"https://dict.youdao.com/dictvoice?audio=hello&type=2","senses":[{"pos":"int.","defs":["喂，你好（用于问候或打招呼）","喂，你好（打电话时的招呼语）","喂，你好（引起别人注意的招呼语）","<非正式>喂，嘿 (认为别人说了蠢话或分心)","<英，旧>嘿（表示惊讶）"]},{"pos":"n.","defs":["招呼，问候","（Hello）（法、印、美、俄）埃洛（人名）"]},{"pos":"v.","defs":["说（或大声说）“喂”","打招呼"]}],"examples":[{"en":"'Oh, hello,' he said, with a smile.","zh":"“嗨，你好。”他微笑着说。","source":"《牛津词典》"},{"en":"Why not start a \"hello\" today?","zh":"为什么不从今天开始说“你好”呢？","source":""},{"en":"Let's go and say hello to her.","zh":"我们去跟她打个招呼吧。","source":""}],"phrases":[{"en":"say hello","zh":"打招呼；问好"},{"en":"hello everyone","zh":"大家好"},{"en":"hello and welcome","zh":"欢迎莅临"},{"en":"hello again","zh":"回魂妻（电影名称）"}],"wordforms":[{"name":"复数","value":"hellos"},{"name":"第三人称单数","value":"helloes"},{"name":"现在分词","value":"helloing"},{"name":"过去式","value":"helloed"},{"name":"过去分词","value":"helloed"}],"derivatives":[],"synonyms":[{"w":"hallo","zh":"喂；哈罗"},{"w":"holloo","zh":"喂；哈罗"}],"source":"有道词典（柯林斯 / 牛津双语例句）","_offline":false}}