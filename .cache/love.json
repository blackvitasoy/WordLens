{"_ts":1795077556668,"data":{"word":"love","ukphone":"lʌv","usphone":"lʌv","ukSpeech":"https://dict.youdao.com/dictvoice?audio=love&type=1","usSpeech":"https://dict.youdao.com/dictvoice?audio=love&type=2","senses":[{"pos":"n.","defs":["（对家庭成员或挚友的）喜爱，关爱","爱情，恋爱","喜好，喜爱","<英，非正式>（昵称）亲爱的","（用于信尾署名前）爱你的","心爱之人，心爱之物","（网球、软式墙网球和其他运动）零分","<非正式>（用于表示对某人的亲切好感）宝贝（a love）","仁慈的人，乐于助人的人","爱神（Love）"]},{"pos":"v.","defs":["爱恋（某人）","关爱（尤指家庭成员或密友）","喜欢（某物或某事）","热爱（国家、组织等）","很愿意","<非正式>感到好笑","适于（某些特定的条件）"]},{"pos":"其他","defs":["【名】 （Love）（英、菲、瑞、美）洛夫（人名）"]}],"examples":[{"en":"Her heart overflowed with love.","zh":"她的心里充满了爱。","source":"《牛津词典》"},{"en":"I really love summer evenings.","zh":"我非常喜欢夏天的夜晚。","source":"《牛津词典》"},{"en":"Their love grew with the years.","zh":"他们的爱逐年加深。","source":"《牛津词典》"}],"phrases":[{"en":"in love","zh":"相爱；恋爱中"},{"en":"of love","zh":"论爱情"},{"en":"for love","zh":"◎为了爱情；◎出于爱好；为了兴趣；为了消遣；不为钱(的)；无偿地"},{"en":"in love with","zh":"热爱；与…相爱"},{"en":"love for","zh":"对…的热爱"},{"en":"true love","zh":"真爱；挚爱，真情"},{"en":"fall in love","zh":"坠入爱河；爱上某人"},{"en":"falling in love","zh":"坠入情网"},{"en":"fall in love with","zh":"爱上"},{"en":"with love","zh":"（信末用语）良好的祝颂"},{"en":"make love","zh":"v. 做爱；示爱（献殷勤）"},{"en":"love all","zh":"双方打成零比零"}],"wordforms":[{"name":"复数","value":"loves"},{"name":"第三人称单数","value":"loves"},{"name":"现在分词","value":"loving"},{"name":"过去式","value":"loved"},{"name":"过去分词","value":"loved"}],"derivatives":[{"w":"lovely","pos":"adj.","zh":"可爱的；令人愉快的"},{"w":"loving","pos":"adj.","zh":"亲爱的；钟情的；忠诚的"},{"w":"lovable","pos":"adj.","zh":"可爱的，讨人喜欢的"},{"w":"loved","pos":"adj.","zh":"恋爱的；受珍爱的"},{"w":"loveless","pos":"adj.","zh":"不可爱的；无爱情的"},{"w":"loveable","pos":"adj.","zh":"可爱的；惹人爱的（等于lovable）"},{"w":"lovingly","pos":"adv.","zh":"亲切地；钟爱地"},{"w":"lover","pos":"n.","zh":"爱人，恋人；爱好者"},{"w":"loveliness","pos":"n.","zh":"可爱；漂亮；魅力；美好"},{"w":"lovingness","pos":"n.","zh":"钟情；爱；忠诚"},{"w":"loved","pos":"v.","zh":"热爱（love的过去分词）"}],"synonyms":[{"w":"passion","zh":"恋爱；亲爱的；酷爱；喜爱的事物"},{