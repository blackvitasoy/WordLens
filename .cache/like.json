{"_ts":1795077375905,"data":{"word":"like","ukphone":"laɪk","usphone":"laɪk","ukSpeech":"https://dict.youdao.com/dictvoice?audio=like&type=1","usSpeech":"https://dict.youdao.com/dictvoice?audio=like&type=2","senses":[{"pos":"prep.","defs":["像，如同","符合……的方式","（指某人常做的事）符合……的特点，像……才会","（用于询问）……怎么样","例如，好比","（用于否定式短语中）比得上","大约，左右"]},{"pos":"v.","defs":["喜欢，喜爱","希望，想要","（用于请求）想要，希望得到","喜欢（做某事、习惯某事）","（用于询问）你觉得……怎么样","对……反感，讨厌","喜好（某种环境）"]},{"pos":"conj.","defs":["像……一样，如同","好像，似乎"]},{"pos":"n.","defs":["喜好，爱好（常复数）","类似或同类的人或物"]},{"pos":"adj.","defs":["类似的，相似的","（画像，图像）逼真的，像的"]},{"pos":"adv.","defs":["（非正式口语，思考说下句话、解释或举例时用）大概，可能","（非正式口语）我说，他说，她说","（非正式口语，代替as）和…一样，像","（非正式口语，代替as）和……一样，像"]},{"pos":"其他","defs":["【名】 （Like）（美、俄、印、英、巴）莉凯（人名）"]}],"examples":[{"en":"The lights shone like diamonds.","zh":"灯光像钻石一样闪闪发亮。","source":"《牛津词典》"},{"en":"Take as much time as you like.","zh":"你想花多少时间就花多少时间。","source":"《牛津词典》"},{"en":"I like it when she reads to us.","zh":"我很喜欢她读书给我们听。","source":"《柯林斯英汉双解大词典》"}],"phrases":[{"en":"look like","zh":"看起来像…"},{"en":"feel like","zh":"想要；感到好似"},{"en":"something like","zh":"有点像；大约；差不多"},{"en":"if you like","zh":"如果你愿意；如果你喜欢的话"},{"en":"nothing like","zh":"没有什么能比得上；一点也不象"},{"en":"anything like","zh":"多少有点像"},{"en":"like as","zh":"[方言]如同，正如"},{"en":"like a dream","zh":"毫不费力地；轻而易举地；完美地"},{"en":"like anything","zh":"[口]拼命地；非常猛地；全力地；象什么似的"},{"en":"such like","zh":"像这类的"},{"en":"like to do","zh":"喜欢做某事（特指某一次）"},{"en":"like crazy","zh":"拼命地；[口]发疯似的"}],"wordforms":[{"name":"复数","value":"likes"},{"name":"第三人称单数","value":"likes"},{"name":"现在分词","value":"liking"},{"name":"过去式","value":"liked"},{"name":"过去分词","value":"liked"}],"derivatives":[{"w":"likely","pos":"adj.","zh":"很可能的；合适的；有希望的"},{"w":"likable","pos":"adj.","zh":"可爱的"},{"w":"likeable","pos":"adj.","zh":"令人喜爱的，可爱的（等于likable）"},{"w":"likewise","pos":"adv.","zh":"同样地；也"},{"w":"likely","pos":"adv.","zh":"很可能；或许"},{"w":"likelihood","pos":"n.","zh":"可能性，可能"},{"w":"liking","pos":"n.","zh":"嗜好，爱好"},{"w":"likeness","pos":"n.","zh":"相似，相像；样子，肖像；照片，画像；相似物"}],"synonyms":[{"w":"love","zh":"喜欢；想；愿意"},{"w":"think","zh":"喜欢；想；愿意"},{"w":"prefer","zh":"喜欢；希望"},{"w":"affect","zh":"喜欢；希望"},{"w":"as per","zh":"像；如同"},{"w":"similar","zh":"同样的；相似的"},{"w":"alike","zh":"同样的；相似的"},{"w":"interest","zh":"爱好；同样的人或物"},{"w":"bent","zh":"爱好；同样的人或物"},{"w":"fond of","zh":"爱好；同样的人或物"},{"w":"perhaps","zh":"可能"},{"w":"maybe","zh":"可能"}],"source":"有道词典（柯林斯 / 牛津双语例句）","_offline":false}}